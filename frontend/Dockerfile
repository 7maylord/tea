FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
ARG NEXT_PUBLIC_PRIVY_APP_ID
ARG NEXT_PUBLIC_API_ORIGIN
ARG NEXT_PUBLIC_CHAIN_ID
ARG NEXT_PUBLIC_SETTLEMENT_TOKEN
ARG NEXT_PUBLIC_CLAIM_ESCROW_ADDRESS
ARG NEXT_PUBLIC_TEA_STREAM_ADDRESS
ARG NEXT_PUBLIC_TEA_DATE_UNLOCK_ADDRESS
ARG NEXT_PUBLIC_AURORA_INTENTS_API_KEY
ARG NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID
ENV NEXT_PUBLIC_API_ORIGIN=$NEXT_PUBLIC_API_ORIGIN
ENV NEXT_PUBLIC_CHAIN_ID=$NEXT_PUBLIC_CHAIN_ID
ENV NEXT_PUBLIC_SETTLEMENT_TOKEN=$NEXT_PUBLIC_SETTLEMENT_TOKEN
ENV NEXT_PUBLIC_CLAIM_ESCROW_ADDRESS=$NEXT_PUBLIC_CLAIM_ESCROW_ADDRESS
ENV NEXT_PUBLIC_TEA_STREAM_ADDRESS=$NEXT_PUBLIC_TEA_STREAM_ADDRESS
ENV NEXT_PUBLIC_TEA_DATE_UNLOCK_ADDRESS=$NEXT_PUBLIC_TEA_DATE_UNLOCK_ADDRESS
ENV NEXT_PUBLIC_AURORA_INTENTS_API_KEY=$NEXT_PUBLIC_AURORA_INTENTS_API_KEY
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable
COPY --from=build /app/package.json /app/pnpm-lock.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["pnpm", "start"]
