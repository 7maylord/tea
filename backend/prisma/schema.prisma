generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(uuid()) @db.Uuid
  privyDid         String          @unique @db.VarChar(128)
  displayName      String?         @db.VarChar(100)
  handle           String?         @unique @db.VarChar(20)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  identities       Identity[]
  accounts         Account[]
  outgoingPayments PaymentIntent[] @relation("OutgoingPayments")
  incomingPayments PaymentIntent[] @relation("IncomingPayments")
  outgoingClaims   Claim[]         @relation("OutgoingClaims")
  outgoingSplits   Split[]         @relation("OutgoingSplits")
  splitObligations SplitObligation[]
  lowerThreads     Thread[]        @relation("LowerThreadUser")
  upperThreads     Thread[]        @relation("UpperThreadUser")

  @@map("users")
}

model Thread {
  id             String          @id @default(uuid()) @db.Uuid
  chainId        Int
  lowerUserId    String          @db.Uuid
  upperUserId    String          @db.Uuid
  lastActivityAt DateTime        @default(now()) @db.Timestamptz(6)
  lowerUser      User            @relation("LowerThreadUser", fields: [lowerUserId], references: [id], onDelete: Restrict)
  upperUser      User            @relation("UpperThreadUser", fields: [upperUserId], references: [id], onDelete: Restrict)
  payments       PaymentIntent[]

  @@unique([chainId, lowerUserId, upperUserId])
  @@index([lastActivityAt, id])
  @@map("threads")
}

model Identity {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  kind                 String   @default("email") @db.VarChar(16)
  encryptedValue       Bytes
  lookupKey            String   @db.Char(64)
  normalizationVersion Int      @default(1)
  verifiedAt           DateTime @db.Timestamptz(6)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([kind, lookupKey])
  @@index([userId])
  @@map("identities")
}

model Account {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  chainId           Int
  accountType       String   @default("privy_embedded") @db.VarChar(32)
  settlementAddress String   @db.VarChar(42)
  signerReference   String?  @db.VarChar(128)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, chainId])
  @@unique([chainId, settlementAddress])
  @@map("accounts")
}

model PaymentIntent {
  id                     String               @id @default(uuid()) @db.Uuid
  payerId                String               @db.Uuid
  recipientUserId        String?              @db.Uuid
  threadId               String?              @db.Uuid
  chainId                Int
  tokenAddress           String               @db.VarChar(42)
  payerAddress           String               @db.VarChar(42)
  recipientAddress       String               @db.VarChar(42)
  amountUnits            Decimal              @db.Decimal(78, 0)
  streamAddress          String?              @db.VarChar(42)
  durationSeconds        BigInt?              @db.BigInt
  streamId               Decimal?             @db.Decimal(78, 0)
  dateUnlockAddress      String?              @db.VarChar(42)
  unlockAt               DateTime?            @db.Timestamptz(6)
  dateLockId             Decimal?             @db.Decimal(78, 0)
  claimId                String?              @unique @db.Char(66)
  preparedAtBlock        BigInt?              @db.BigInt
  kind                   String               @db.VarChar(16)
  state                  String               @db.VarChar(32)
  idempotencyKey         String?              @db.VarChar(128)
  requestHash            String               @db.Char(64)
  authorizationExpiresAt DateTime             @db.Timestamptz(6)
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(6)
  payer                  User                 @relation("OutgoingPayments", fields: [payerId], references: [id], onDelete: Restrict)
  recipient              User?                @relation("IncomingPayments", fields: [recipientUserId], references: [id], onDelete: Restrict)
  thread                 Thread?              @relation(fields: [threadId], references: [id], onDelete: Restrict)
  claim                  Claim?               @relation(fields: [claimId], references: [id], onDelete: Restrict)
  attempts               TransactionAttempt[]
  streamActions          StreamAction[]
  dateUnlockActions      DateUnlockAction[]
  splitObligation        SplitObligation?

  @@unique([payerId, idempotencyKey])
  @@index([payerId, state, authorizationExpiresAt])
  @@index([threadId, createdAt, id])
  @@map("payment_intents")
}

model TransactionAttempt {
  id             String        @id @default(uuid()) @db.Uuid
  intentId       String        @db.Uuid
  operationIndex Int
  chainId        Int
  txHash         String        @db.VarChar(66)
  state          String        @db.VarChar(32)
  idempotencyKey String        @db.VarChar(128)
  requestHash    String        @db.Char(64)
  submittedAt    DateTime      @default(now()) @db.Timestamptz(6)
  confirmedAt    DateTime?     @db.Timestamptz(6)
  blockNumber    BigInt?       @db.BigInt
  blockHash      String?       @db.VarChar(66)
  intent         PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([chainId, txHash])
  @@unique([intentId, idempotencyKey])
  @@index([intentId, operationIndex])
  @@map("transaction_attempts")
}

model StreamAction {
  id                     String        @id @default(uuid()) @db.Uuid
  intentId               String        @db.Uuid
  chainId                Int
  kind                   String        @db.VarChar(16)
  actorAddress           String        @db.VarChar(42)
  state                  String        @db.VarChar(32)
  idempotencyKey         String        @db.VarChar(128)
  requestHash            String        @db.Char(64)
  preparedAtBlock        BigInt        @db.BigInt
  txHash                 String?       @db.VarChar(66)
  submissionKey          String?       @db.VarChar(128)
  submissionHash         String?       @db.Char(64)
  amountUnits            Decimal?      @db.Decimal(78, 0)
  blockNumber            BigInt?       @db.BigInt
  blockHash              String?       @db.VarChar(66)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)
  intent                 PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([intentId, idempotencyKey])
  @@unique([chainId, txHash])
  @@index([intentId, createdAt, id])
  @@map("stream_actions")
}

model DateUnlockAction {
  id                     String        @id @default(uuid()) @db.Uuid
  intentId               String        @db.Uuid
  chainId                Int
  actorAddress           String        @db.VarChar(42)
  state                  String        @db.VarChar(32)
  idempotencyKey         String        @db.VarChar(128)
  requestHash            String        @db.Char(64)
  preparedAtBlock        BigInt        @db.BigInt
  txHash                 String?       @db.VarChar(66)
  submissionKey          String?       @db.VarChar(128)
  submissionHash         String?       @db.Char(64)
  amountUnits            Decimal?      @db.Decimal(78, 0)
  blockNumber            BigInt?       @db.BigInt
  blockHash              String?       @db.VarChar(66)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)
  intent                 PaymentIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([intentId, idempotencyKey])
  @@unique([chainId, txHash])
  @@index([intentId, createdAt, id])
  @@map("date_unlock_actions")
}

model Claim {
  id                     String               @id @db.Char(66)
  payerId                String               @db.Uuid
  chainId                Int
  escrowAddress          String               @db.VarChar(42)
  tokenAddress           String               @db.VarChar(42)
  payerAddress           String               @db.VarChar(42)
  amountUnits            Decimal              @db.Decimal(78, 0)
  identityLookupKey      String               @db.Char(64)
  identityCommitment     String               @db.Char(66)
  encryptedRecipientEmail Bytes
  encryptedBindingSecret Bytes
  inviteTokenHash        String               @unique @db.Char(64)
  encryptedInviteToken   Bytes
  preparedAtBlock        BigInt               @db.BigInt
  preparationExpiresAt   DateTime             @db.Timestamptz(6)
  expiry                 DateTime?            @db.Timestamptz(6)
  state                  String               @db.VarChar(32)
  idempotencyKey         String               @db.VarChar(128)
  requestHash            String               @db.Char(64)
  depositTxHash          String?              @db.VarChar(66)
  depositSubmissionKey   String?              @db.VarChar(128)
  depositSubmissionHash  String?              @db.Char(64)
  depositBlockNumber     BigInt?              @db.BigInt
  depositBlockHash       String?              @db.VarChar(66)
  createdAt              DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(6)
  payer                  User                 @relation("OutgoingClaims", fields: [payerId], references: [id], onDelete: Restrict)
  authorizations         ClaimAuthorization[]
  outboxJobs             OutboxJob[]
  receipt                PaymentIntent?

  @@unique([payerId, idempotencyKey])
  @@unique([chainId, escrowAddress, depositTxHash])
  @@index([state, expiry])
  @@map("claims")
}

model ClaimAuthorization {
  id               String   @id @default(uuid()) @db.Uuid
  claimId          String   @db.Char(66)
  nonce            Decimal  @db.Decimal(78, 0)
  recipientAddress String   @db.VarChar(42)
  deadline         DateTime @db.Timestamptz(6)
  signerEpoch      BigInt   @db.BigInt
  digest           String   @db.Char(66)
  identitySignature Bytes
  recipientSignature Bytes?
  idempotencyKey   String   @db.VarChar(128)
  requestHash      String   @db.Char(64)
  state            String   @db.VarChar(32)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  claim            Claim    @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([claimId, state])
  @@unique([claimId, idempotencyKey])
  @@map("claim_authorizations")
}

model OutboxJob {
  id            String    @id @default(uuid()) @db.Uuid
  claimId       String    @db.Char(66)
  kind          String    @db.VarChar(32)
  dedupeKey     String    @unique @db.VarChar(128)
  state         String    @db.VarChar(16)
  attempts      Int       @default(0)
  txHash        String?   @db.VarChar(66)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(6)
  leaseUntil    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  claim         Claim     @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([state, nextAttemptAt])
  @@map("outbox_jobs")
}


model Split {
  id               String            @id @default(uuid()) @db.Uuid
  organizerId      String            @db.Uuid
  chainId          Int
  tokenAddress     String            @db.VarChar(42)
  organizerAddress String            @db.VarChar(42)
  title            String?           @db.VarChar(80)
  totalAmountUnits Decimal           @db.Decimal(78, 0)
  state            String            @db.VarChar(32)
  expiresAt        DateTime          @db.Timestamptz(6)
  idempotencyKey   String            @db.VarChar(128)
  requestHash      String            @db.Char(64)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  organizer        User              @relation("OutgoingSplits", fields: [organizerId], references: [id], onDelete: Restrict)
  obligations      SplitObligation[]

  @@unique([organizerId, idempotencyKey])
  @@index([organizerId, createdAt, id])
  @@index([state, expiresAt])
  @@map("splits")
}

model SplitObligation {
  id                String         @id @default(uuid()) @db.Uuid
  splitId           String         @db.Uuid
  participantUserId String         @db.Uuid
  participantAddress String        @db.VarChar(42)
  amountUnits       Decimal        @db.Decimal(78, 0)
  state             String         @db.VarChar(32)
  paymentIntentId   String?        @unique @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(6)
  split             Split          @relation(fields: [splitId], references: [id], onDelete: Restrict)
  participant       User           @relation(fields: [participantUserId], references: [id], onDelete: Restrict)
  paymentIntent     PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@unique([splitId, participantUserId])
  @@index([participantUserId, state, createdAt])
  @@map("split_obligations")
}
