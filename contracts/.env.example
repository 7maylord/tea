# Copy to .env (ignored by Git). Never use Anvil's public development keys.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=
# Zero deploys a new valueless TestUSD. Or set an existing 6-decimal token address.
SETTLEMENT_TOKEN=0x0000000000000000000000000000000000000000
# Public address of the backend's claim authorization signer.
CLAIM_IDENTITY_SIGNER=
# Public address controlling pause and signer rotation.
CLAIM_ADMIN=
