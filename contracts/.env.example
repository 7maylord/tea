# Copy to .env (ignored by Git). Never use Anvil's public development keys.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=
# Existing TEA TestUSD. Zero deploys a new valueless TestUSD instead.
SETTLEMENT_TOKEN=0x82cE012544F85E33930C5272bdeAE76736A8F22b
# Optional second supported token. Official Agora AUSD on Monad testnet:
AUSD_TOKEN=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# Public address of the backend's claim authorization signer.
CLAIM_IDENTITY_SIGNER=
# Public address controlling pause and signer rotation.
CLAIM_ADMIN=
